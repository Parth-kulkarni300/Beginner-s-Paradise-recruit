# Beginner's Paradise — RecruitShield AI
# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub

# Gemini API Key — for AI-powered recruiter summaries
GEMINI_API_KEY=your_gemini_api_key_here

# Hugging Face Token — for sentence embedding model inference
HF_TOKEN=your_huggingface_token_here

# Allowed CORS Origins (defaults to * for open access)
ALLOWED_ORIGINS=*
