# RecruitShield AI Environment Variables Example
# Rename this file to .env for local testing (do not commit .env to GitHub)

# Gemini API Key (Optional: for conversational AI chatbot answers)
GEMINI_API_KEY=your_gemini_api_key_here

# Hugging Face Token (Optional: for cloud embedding inference)
HF_TOKEN=your_huggingface_token_here

# Allowed CORS Origins (Optional: defaults to * for open API access)
ALLOWED_ORIGINS=*
